diff --git a/tests-unit/comfy_test/test_minimax_compiler_wrappers.py b/tests-unit/comfy_test/test_minimax_compiler_wrappers.py
new file mode 100644
--- /dev/null
+++ b/tests-unit/comfy_test/test_minimax_compiler_wrappers.py
@@ -0,0 +1,112 @@
+import ast
+import importlib.util
+from pathlib import Path
+from types import SimpleNamespace
+import unittest
+
+import torch
+
+
+ROOT = Path(__file__).parents[2]
+
+
+def harness(compiled=True, wrapper=None):
+    spec = importlib.util.spec_from_file_location("patcher_for_test", ROOT / "comfy/patcher_extension.py")
+    patcher = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(patcher)
+    state = {"active": False, "events": []}
+
+    def begin(*args):
+        assert not state["active"]
+        state["active"] = True
+        state["events"].append("begin")
+
+    def end():
+        assert state["active"]
+        state["events"].append("end")
+        state["active"] = False
+
+    prefetch = SimpleNamespace(malloc_graph_enabled=lambda device: compiled, malloc_graph_begin=begin, malloc_graph_end=end)
+    path = ROOT / "comfy/ldm/minimax/model.py"
+    source = ast.parse(path.read_text(encoding="utf-8"))
+    model_class = next(n for n in source.body if isinstance(n, ast.ClassDef) and n.name == "MiniMaxH3Model")
+    model_class.body = [n for n in model_class.body if isinstance(n, ast.FunctionDef) and n.name in {"forward", "_forward_with_memory_graph"}]
+    tree = ast.Module(body=[model_class], type_ignores=[])
+    namespace = {"torch": torch, "nn": torch.nn, "comfy": SimpleNamespace(model_prefetch=prefetch, patcher_extension=patcher)}
+    exec(compile(tree, str(path), "exec"), namespace)  # noqa: S102 -- CPU-only test of this repository's model methods.
+    model = namespace["MiniMaxH3Model"]()
+
+    def body(x, *args, **kwargs):
+        assert state["active"] == compiled
+        state["events"].append("body")
+        return [x[0] + 1, x[1] - 2]
+
+    model._forward = body
+    options = {}
+    if wrapper is not None:
+        options["wrappers"] = {patcher.WrappersMP.DIFFUSION_MODEL: {None: [lambda executor, *args, **kwargs: wrapper(state, executor, *args, **kwargs)]}}
+    x = [torch.ones(1, 24, 2, 2, 2), torch.ones(1, 32, 2, 8)]
+    return model, state, lambda: model(x, torch.ones(1), torch.zeros(1, 2, 3), options)
+
+
+def test_wrapper_preparation_and_cleanup_are_outside_capture():
+    def wrapper(state, executor, *args, **kwargs):
+        assert not state["active"], "wrapper preparation entered memory capture"
+        state["events"].append("prepare")
+        result = executor(*args, **kwargs)
+        assert not state["active"], "wrapper cleanup entered memory capture"
+        state["events"].append("cleanup")
+        return result
+
+    _, state, call = harness(wrapper=wrapper)
+    call()
+    assert state["events"] == ["prepare", "begin", "body", "end", "cleanup"]
+
+
+def test_wrapper_result_is_preserved_with_and_without_compiler():
+    def wrapper(state, executor, *args, **kwargs):
+        result = executor(*args, **kwargs)
+        return [result[0] * 3, result[1] * 4]
+
+    for compiled in (False, True):
+        _, state, call = harness(compiled=compiled, wrapper=wrapper)
+        result = call()
+        assert torch.equal(result[0], torch.full_like(result[0], 6))
+        assert torch.equal(result[1], torch.full_like(result[1], -4))
+        assert not state["active"]
+
+
+def test_preparation_exception_does_not_open_capture():
+    def wrapper(state, executor, *args, **kwargs):
+        raise RuntimeError("preparation failed")
+
+    _, state, call = harness(wrapper=wrapper)
+    with unittest.TestCase().assertRaisesRegex(RuntimeError, "preparation failed"):
+        call()
+    assert not state["active"]
+    assert state["events"] == []
+
+
+def test_cleanup_exception_leaves_capture_closed():
+    def wrapper(state, executor, *args, **kwargs):
+        executor(*args, **kwargs)
+        raise RuntimeError("cleanup failed")
+
+    _, state, call = harness(wrapper=wrapper)
+    with unittest.TestCase().assertRaisesRegex(RuntimeError, "cleanup failed"):
+        call()
+    assert not state["active"]
+    assert state["events"] == ["begin", "body", "end"]
+
+
+def test_plain_model_still_records_every_forward():
+    _, state, call = harness()
+    call()
+    call()
+    assert state["events"] == ["begin", "body", "end"] * 2
+
+
+if __name__ == "__main__":
+    suite = unittest.TestSuite(unittest.FunctionTestCase(value) for name, value in list(globals().items()) if name.startswith("test_"))
+    result = unittest.TextTestRunner().run(suite)
+    raise SystemExit(not result.wasSuccessful())
